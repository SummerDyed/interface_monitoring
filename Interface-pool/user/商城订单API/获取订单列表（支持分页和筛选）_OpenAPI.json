{
  "GET /api/v1/user/mall/orders": {
    "url": "https://maibanjk.com/maiban-user/api/v1/user/mall/orders",
    "method": "GET",
    "path": "/api/v1/user/mall/orders",
    "parameters": {
      "status": {
        "in": "query",
        "description": "订单状态筛选（单值或逗号分隔多值）：0待支付/1已支付/2待发货/3配送中/4已完成/5已取消/6待成团/7已评价/8退款中/9已退款；多值示例 status=0,1,5",
        "required": false,
        "type": "string",
        "example": "0,1"
      },
      "orderType": {
        "in": "query",
        "description": "订单类型筛选：0-普通/1-团购/2-套餐订阅",
        "required": false,
        "type": "integer",
        "example": ""
      },
      "memberId": {
        "in": "query",
        "description": "家庭成员ID筛选",
        "required": false,
        "type": "integer",
        "example": ""
      },
      "keyword": {
        "in": "query",
        "description": "搜索关键词（订单号/商品名称）",
        "required": false,
        "type": "string",
        "example": ""
      },
      "page": {
        "in": "query",
        "description": "页码，默认1",
        "required": false,
        "type": "integer",
        "example": ""
      },
      "pageSize": {
        "in": "query",
        "description": "每页条数，默认20",
        "required": false,
        "type": "integer",
        "example": ""
      }
    }
  }
}