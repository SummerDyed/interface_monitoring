{
  "GET /api/v1/user/subscription/{id}/calendar": {
    "url": "https://maibanjk.com/maiban-user/api/v1/user/subscription/{id}/calendar",
    "method": "GET",
    "path": "/api/v1/user/subscription/{id}/calendar",
    "parameters": {
      "id": {
        "in": "path",
        "description": "订阅ID",
        "required": true,
        "type": "integer",
        "example": 6
      },
      "year": {
        "in": "query",
        "description": "年份，不传默认当前年份",
        "required": false,
        "type": "integer",
        "example": 2026
      },
      "month": {
        "in": "query",
        "description": "月份，1-12；不传默认当前月份",
        "required": false,
        "type": "integer",
        "example": 5
      }
    }
  }
}