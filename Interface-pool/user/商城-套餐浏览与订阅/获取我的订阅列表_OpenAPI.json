{
  "GET /api/v1/user/subscription/my": {
    "url": "https://maibanjk.com/maiban-user/api/v1/user/subscription/my",
    "method": "GET",
    "path": "/api/v1/user/subscription/my",
    "parameters": {
      "status": {
        "in": "query",
        "description": "订阅状态：0-生效中，1-已暂停，2-已取消；不传表示全部",
        "required": false,
        "type": "integer",
        "example": 0
      },
      "page": {
        "in": "query",
        "description": "页码，从1开始",
        "required": false,
        "type": "integer",
        "example": 1
      },
      "pageSize": {
        "in": "query",
        "description": "每页数量，默认20，最大100",
        "required": false,
        "type": "integer",
        "example": 20
      }
    }
  }
}