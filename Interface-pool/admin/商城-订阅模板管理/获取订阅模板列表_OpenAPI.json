{
  "GET /admin/api/v1/mall/subscription-template/list": {
    "url": "https://maibanjk.com/maiban-user/admin/api/v1/mall/subscription-template/list",
    "method": "GET",
    "path": "/admin/api/v1/mall/subscription-template/list",
    "parameters": {
      "status": {
        "in": "query",
        "description": "状态：0-下架，1-上架；不传表示全部",
        "required": false,
        "type": "string",
        "example": 1
      },
      "targetType": {
        "in": "query",
        "description": "关联类型：仅支持 PRODUCT；不传默认 PRODUCT",
        "required": false,
        "type": "string",
        "example": "PRODUCT"
      },
      "targetId": {
        "in": "query",
        "description": "关联对象ID；不传表示全部",
        "required": false,
        "type": "integer",
        "example": 101
      },
      "keyword": {
        "in": "query",
        "description": "按模板名称模糊筛选",
        "required": false,
        "type": "string",
        "example": "降压"
      },
      "page": {
        "in": "query",
        "description": "页码，从1开始",
        "required": false,
        "type": "integer",
        "example": 1
      },
      "pageSize": {
        "in": "query",
        "description": "每页条数，默认20，最大100",
        "required": false,
        "type": "integer",
        "example": 20
      }
    }
  }
}