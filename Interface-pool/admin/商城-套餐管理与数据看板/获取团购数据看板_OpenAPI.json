{
  "GET /admin/api/v1/mall/package/group-buy/statistics": {
    "url": "https://maibanjk.com/maiban-user/admin/api/v1/mall/package/group-buy/statistics",
    "method": "GET",
    "path": "/admin/api/v1/mall/package/group-buy/statistics",
    "parameters": {
      "startDate": {
        "in": "query",
        "description": "统计开始日期，格式 YYYY-MM-DD",
        "required": false,
        "type": "string",
        "example": "2026-05-01"
      },
      "endDate": {
        "in": "query",
        "description": "统计结束日期，格式 YYYY-MM-DD",
        "required": false,
        "type": "string",
        "example": "2026-05-31"
      },
      "category": {
        "in": "query",
        "description": "类目筛选：0-健康食品，1-产后护理，2-陪诊，3-家政，4-陪护；不传表示全部",
        "required": false,
        "type": "integer",
        "example": 0
      }
    }
  }
}