{
  "GET /admin/api/v1/mall/package/statistics/subscription": {
    "url": "https://maibanjk.com/maiban-user/admin/api/v1/mall/package/statistics/subscription",
    "method": "GET",
    "path": "/admin/api/v1/mall/package/statistics/subscription",
    "parameters": {
      "startDate": {
        "in": "query",
        "description": "统计开始日期，格式 YYYY-MM-DD；不传则使用系统默认统计范围",
        "required": false,
        "type": "string",
        "example": "2026-05-01"
      },
      "endDate": {
        "in": "query",
        "description": "统计结束日期，格式 YYYY-MM-DD；不传则使用系统默认统计范围",
        "required": false,
        "type": "string",
        "example": "2026-05-31"
      },
      "packageType": {
        "in": "query",
        "description": "套餐类型/周期类型：0-周套餐，1-半月套餐，2-月套餐；不传表示全部",
        "required": false,
        "type": "integer",
        "example": 2
      }
    }
  }
}